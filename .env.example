# Athena LLM 凭据（复制为 .env 后填写）

# 必填二选一：DeepSeek 或 OpenAI 兼容 API key
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 可选：OpenAI 兼容端点与默认模型
# BASE_URL=https://api.deepseek.com
# 模型档位：flash(快/省，默认) 与 pro(强/贵)
# MODEL_NAME=deepseek-v4-flash
# MODEL_PRO=deepseek-v4-pro

# 可选：LLM 后端类型，deepseek | openai | anthropic，默认 deepseek
# LLM_PROVIDER=deepseek

# ── Academic Survey（Athena-cli survey / paper_survey 工具）────────────────
# 全部可选：缺哪个就关掉哪个能力，链路在降级形态下仍然完整可跑。
# 用 `Athena-cli survey --check` 查看当前装配结果。

# PaperScout 的策略模型；不设沿用 MODEL_NAME
# ATHENA_SURVEY_MODEL=

# 相关性打分模型；不设沿用策略模型。
# 打分是调用次数最多的一环（一轮四步就发了 38 次，策略只有 4 次），换轻量模型是
# 压缩总时长性价比最高的一处。注意换模型后门槛口径会变：只有 >0.45（三分档）跨模型
# 稳定，别用 --retain-threshold 0.3。
# ATHENA_SCORER_MODEL=

# 句向量模型；不设则语义检索关闭，关键词检索与整篇读取照常
# ATHENA_EMBEDDING_MODEL=

# 图表解读的多模态模型；不设则图表退回仅证据文本
# ATHENA_VISION_MODEL=

# artifact 根目录；默认 ~/.athena/artifacts（刻意放仓库外：取源会下载 TeX 包与 PDF）
# ATHENA_ARTIFACT_ROOT=

# arXiv / OpenAlex 礼貌池联系邮箱。会随每次请求发给第三方站点，填不填自己决定
# ATHENA_CONTACT_EMAIL=

# Semantic Scholar key：影响比看上去大。实测同一查询无 key 时 19 次 search 有 15 次
# 429、候选池 148 篇；配上 key 后 28 次动作只剩 4 次失败、池 240 篇
# SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex key；不设走匿名额度
# OPENALEX_API_KEY=

# Ghostscript 可执行文件，用于光栅化 EPS/PS 插图（2015 年前的 arXiv 论文几乎全用
# EPS）；不设按 PATH 自动发现 gs / gswin64c / mgs 等
# ATHENA_GHOSTSCRIPT=
