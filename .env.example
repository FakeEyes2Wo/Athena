# Athena 环境变量模板（复制为 .env 后填写）
#
# 非密钥配置（provider / base_url / model_name / model_pro / retry 等）已集中到
# config.example.toml（复制为 config.toml 后生效）。本文件只放密钥与需要临时用
# 环境变量覆盖的项。优先级：系统环境变量 > .env > config.toml > 内置默认值。

# 必填三选一：按 LLM_PROVIDER 选对应的一个
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=            # LLM_PROVIDER=qwen 时用（阿里云百炼）

# 可选：覆盖 config.toml 里的 [llm] 非密钥配置
# BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-v4-flash
# MODEL_PRO=deepseek-v4-pro
# LLM_PROVIDER=deepseek         # deepseek | openai | qwen

# 采样参数：要可复现、可申报的运行就把这两项设成定值。
# 不设 LLM_SEED 时请求里不带 seed 字段（不认它的后端会直接 400）。
# LLM_TEMPERATURE=0.1
# LLM_SEED=62
# LLM_ENABLE_THINKING=false

# ── Academic Survey（Athena-cli survey / paper_survey 工具）────────────────
# 全部可选：缺哪个就关掉哪个能力，链路在降级形态下仍然完整可跑。
# 用 `Athena-cli survey --check` 查看当前装配结果。

# PaperScout 的策略模型；不设沿用 MODEL_NAME
# ATHENA_SURVEY_MODEL=

# 相关性打分模型；不设沿用策略模型。
# 打分是调用次数最多的一环（一轮四步就发了 38 次，策略只有 4 次），换轻量模型是
# 压缩总时长性价比最高的一处。注意换模型后门槛口径会变：只有 >0.45（三分档）跨模型
# 稳定，别用 --retain-threshold 0.3。
# ATHENA_SCORER_MODEL=

# 同分论文的次序信号：交叉编码器（DashScope text-rerank）。不设则退回散列排序。
# 打分只有四个取值，真机一轮 352 篇里 197 篇同分、截断线正好落在那一档，此前这将近
# 一半的交付集合由 sha256 决定。接上之后同一位置的排序可复现性从 0.690 升到 0.791
# （前 20 篇 Jaccard），打完 352 篇只要 0.4 秒。凭据复用 OPENAI_API_KEY。
# ATHENA_RERANK_MODEL=gte-rerank-v2

# 句向量模型；不设则语义检索关闭，关键词检索与整篇读取照常
# ATHENA_EMBEDDING_MODEL=

# 图表解读的多模态模型；不设则图表退回仅证据文本
# ATHENA_VISION_MODEL=

# artifact 根目录；默认 ~/.athena/artifacts（刻意放仓库外：取源会下载 TeX 包与 PDF）
# ATHENA_ARTIFACT_ROOT=

# arXiv / OpenAlex 礼貌池联系邮箱。会随每次请求发给第三方站点，填不填自己决定
# ATHENA_CONTACT_EMAIL=

# Semantic Scholar key：影响比看上去大。实测同一查询无 key 时 19 次 search 有 15 次
# 429、候选池 148 篇；配上 key 后 28 次动作只剩 4 次失败、池 240 篇
# SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex key；不设走匿名额度
# OPENALEX_API_KEY=

# Ghostscript 可执行文件，用于光栅化 EPS/PS 插图（2015 年前的 arXiv 论文几乎全用
# EPS）；不设按 PATH 自动发现 gs / gswin64c / mgs 等
# ATHENA_GHOSTSCRIPT=

# ── Kaggle（Athena-cli kaggle / kaggle_* 工具）────────────────────────────
# 新版 API token（形如 KGAT_...），走 Authorization: Bearer；不设则退回
# ~/.kaggle/kaggle.json 的 username+key（HTTP Basic）。
# KAGGLE_API_TOKEN=

# Kaggle 数据下载根目录；默认 cwd/kaggle-data
# ATHENA_KAGGLE_DOWNLOAD_ROOT=

# EDA / SOTA 分析不由 Kaggle 模块完成：下载后数据交由 prepare/ideator 等
# agent 用自己的 workspace + shell 代码生成流程自行分析（沿用全局 MODEL_NAME）。
