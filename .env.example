# Athena LLM 凭据（复制为 .env 后填写）

# 必填二选一：DeepSeek 或 OpenAI 兼容 API key
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 可选：OpenAI 兼容端点与默认模型
# BASE_URL=https://api.deepseek.com
# 模型档位：flash(快/省，默认) 与 pro(强/贵)
# MODEL_NAME=deepseek-v4-flash
# MODEL_PRO=deepseek-v4-pro

# 可选：LLM 后端类型，deepseek | openai | anthropic，默认 deepseek
# LLM_PROVIDER=deepseek
