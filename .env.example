# 复制为 .env 后填写。.env 已被 .gitignore 忽略。

# OpenAI 兼容端点的密钥与地址。
# 留空 OPENAI_BASE_URL 走 OpenAI 官方地址；接百炼 / vLLM / 其他网关时填对应地址。
OPENAI_API_KEY=
OPENAI_BASE_URL=

# TUI 的默认模型。优先级高于 agent profile 工厂的签名默认值，
# 且 /agent 切换 profile 后依然生效。会话内可用 /model 临时覆盖。
ATHENA_TUI_MODEL=

# 可选：TUI 输入历史文件路径。设为空串则只用内存历史。
# ATHENA_TUI_HISTORY=

# 可选：强制 ASCII 符号（终端不支持 Unicode 时）。
# ATHENA_TUI_ASCII=1

# Academic Survey 全链路（python -m athena.research）。

# PaperScout 的策略模型（每步决定下一步搜什么、从哪篇扩展）。留空则回落到 ATHENA_TUI_MODEL。
ATHENA_RESEARCH_MODEL=

# 相关性打分模型。留空沿用策略模型。
# 打分是四档分类（读标题加摘要判 0/1/2/3），却是调用次数最多的一环——实测一轮 4 步发了
# 38 次打分、只有 4 次策略调用。延迟由输出 token 决定：策略一次约 2210 token / 39 秒，
# 打分一次约 857 token / 16 秒。scout 占全链路 69% 的墙钟，换轻量模型是最省时间的一处。
#
# 换模型前先读这条：只有 3 分档跨模型稳定。同一批 150 篇论文实测，> 0.45 的门槛下两个
# 模型都交付 2 篇且是同样那 2 篇；> 0.2 的门槛下一个 29-37 篇、另一个 17 篇，差一倍。
# 2 分档连同一个模型自己连打两遍都只有 77% 稳定。所以换打分模型时 --retain-threshold
# 保持默认 0 或用 0.5，不要用 0.3。
ATHENA_SCORER_MODEL=

# 句向量模型。留空则关闭语义检索，关键词检索与整篇读取照常可用。
ATHENA_EMBEDDING_MODEL=

# 图表解读用的多模态模型。留空则图表退回"仅标题与说明文字"，
# 且 visual_policy=required 的论文会直接失败。
ATHENA_VISION_MODEL=

# artifact 根目录。留空则用 ~/.athena/artifacts。
# 取源阶段会下载 TeX 包与 PDF，不要指向仓库内部。
# ATHENA_ARTIFACT_ROOT=

# 可选：联系邮箱，写进 User-Agent。arXiv 与 OpenAlex 据此识别礼貌客户端。
# ATHENA_CONTACT_EMAIL=

# 检索后端凭据。强烈建议配 S2 key：实测无 key 时 19 次检索有 15 次 429，
# 候选池 148 篇；配上后同一查询 28 次动作只剩 4 次失败，池 240 篇。
# SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex key 只提高免费元数据额度（匿名 0.10 美元/天 → 1 美元/天），
# 计费内容端点另由 allow_paid_content_api 控制，默认关闭。
# OPENALEX_API_KEY=

# 可选：Ghostscript 可执行文件路径，用于把 EPS/PS 插图光栅化成 PNG 送视觉模型。
# 留空则按 PATH 自动查找 gs / gswin64c / gswin32c / mgs / rungs。
# MiKTeX 与 TeX Live 都自带一份（mgs / rungs），装了 TeX 发行版通常无需另配。
# 找不到时 EPS 插图退回仅标题证据，并记 visual_preview_unavailable 诊断。
# ATHENA_GHOSTSCRIPT=
